{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts",
    "drizzle-db.ts",
    "migrate.ts",
    "drizzle.config.ts",
    "drizzle/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
